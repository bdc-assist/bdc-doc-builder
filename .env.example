# --- bdc-doc-mcp ingest API (where built content is pushed) ---
DOC_MCP_URL=http://127.0.0.1:8000
INGEST_TOKEN=change-me            # must match INGEST_TOKEN on the bdc-doc-mcp side
# PUSH_BATCH=200                  # chunks per upsert request

# --- embeddings (MUST be the same model bdc-doc-mcp uses for queries) ---
# provider is inferred from the URL (ollama / azure.com / other=vllm; unset=openai);
# set EMBEDDING_MODEL_PROVIDER to override
EMBEDDING_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# EMBEDDING_MODEL_PROVIDER=ollama
# EMBEDDING_BATCH_TOKENS=6000     # per-request token budget when embedding

# --- completion LLM (chunk contextualizer / summarizer) ---
COMPLETION_URL=
COMPLETION_MODEL=gpt-4o-mini
# COMPLETION_MODEL_PROVIDER=azure
# AZURE_API_VERSION=2024-10-21
OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# CONTEXT_CHAR_LIMIT=16000        # situating-context truncation for the contextualizer

# --- sources ---
# BDC_WEBSITE_DIR=../interim-bdc-website/
# BDC_GITBOOK_DIR=../bdc-gitbook/
# PREPROC_DATA_DIR=./data/
