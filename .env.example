# --- r-doc-mcp ingest API (where built content is pushed) ---
DOC_MCP_URL=http://127.0.0.1:8000
INGEST_TOKEN=change-me            # must match INGEST_TOKEN on the r-doc-mcp side
# PUSH_BATCH=200                  # chunks per upsert request
# PUSH_TIMEOUT=300                # seconds allowed for one ingest API request

# --- embeddings (MUST be the same model r-doc-mcp uses for queries) ---
# provider is inferred from the URL (ollama / azure.com / other=vllm; unset=openai);
# set EMBEDDING_MODEL_PROVIDER to override
EMBEDDING_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# EMBEDDING_MODEL_PROVIDER=ollama
# EMBEDDING_BATCH_TOKENS=6000     # per-request token budget when embedding
# RETRIES=5                       # attempts per LLM / embedding call before giving up

# --- completion LLM (chunk contextualizer / summarizer) ---
COMPLETION_URL=
COMPLETION_MODEL=gpt-4o-mini
# COMPLETION_MODEL_PROVIDER=azure
# AZURE_API_VERSION=2024-10-21
OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# CONTEXT_CHAR_LIMIT=16000        # situating-context truncation for the contextualizer
# SUMMARY_MIN_CHARS=300           # ingest --summarize: texts shorter than this are embedded as-is
# COMPLETION_TEMPERATURE=0        # sampling temperature, every provider

# --- sources ---
# chunking, html and caption settings are not env: they live in <CONFIG_DIR>/build.yaml
# CONFIG_DIR=config               # folder holding sources.yaml, prompts.yaml, build.yaml; examples/bdc for BDC, examples/fastapi for FastAPI
# REPOS_DIR=./data/repos/         # where git sources are cloned
# REQUEST_TIMEOUT=60              # seconds allowed for one source download (page, captions)
# USER_AGENT=Mozilla/5.0          # User-Agent sent with page, freshdesk and transcript downloads
# PREPROC_DATA_DIR=./data/<config>/  # where the .pkl files go; default: data/ + the CONFIG_DIR folder name (config, bdc, ...)
